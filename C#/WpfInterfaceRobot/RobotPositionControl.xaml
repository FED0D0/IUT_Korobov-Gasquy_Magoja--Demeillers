<UserControl x:Class="WpfInterfaceRobot.RobotPositionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#20242A">

        <Canvas x:Name="GraphCanvas"
                Background="#252A31"
                SizeChanged="GraphCanvas_SizeChanged">

            <!-- Grille -->
            <Canvas x:Name="GridCanvas"
                    IsHitTestVisible="False"/>

            <!-- Axe X -->
            <Line x:Name="XAxis"
                  Stroke="#808080"
                  StrokeThickness="1.5"
                  IsHitTestVisible="False"/>

            <!-- Axe Y -->
            <Line x:Name="YAxis"
                  Stroke="#808080"
                  StrokeThickness="1.5"
                  IsHitTestVisible="False"/>

            <!--
                ROBOT

                Le point 0,0 du Polygon est le barycentre
                du robot.

                La pointe de la flèche est dirigée vers +X.
            -->
            <Polygon x:Name="RobotArrow"
                     Points="20,0 -10,-10 -10,10"
                     Fill="#00BFFF"
                     Stroke="White"
                     StrokeThickness="1.5"
                     RenderTransformOrigin="0,0"/>

            <!-- Centre du robot -->
            <Ellipse x:Name="RobotCenter"
                     Width="5"
                     Height="5"
                     Fill="White"
                     IsHitTestVisible="False"/>

            <!-- Waypoint -->
            <Ellipse x:Name="WaypointMarker"
                     Width="12"
                     Height="12"
                     Fill="#303030"
                     Stroke="#FFB000"
                     StrokeThickness="2"/>

            <!-- Orientation du waypoint -->
            <Line x:Name="WaypointDirection"
                  Stroke="#FFB000"
                  StrokeThickness="2"/>

            <!-- Labels -->
            <TextBlock x:Name="XAxisLabel"
                       Text="+X"
                       Foreground="#AAAAAA"
                       FontSize="11"/>

            <TextBlock x:Name="YAxisLabel"
                       Text="+Y"
                       Foreground="#AAAAAA"
                       FontSize="11"/>

        </Canvas>

    </Grid>

</UserControl>